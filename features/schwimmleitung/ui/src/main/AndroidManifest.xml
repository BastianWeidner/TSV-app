<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Keine Internet-Berechtigung: Die geteilte Datei liegt in Google Drive und läuft über den Android-Dateidialog. -->
    <application>
        <!-- Gibt erzeugte PDFs/CSVs an die gewählte App frei und nimmt Kamerafotos für Meldungen und Belege entgegen. -->
        <provider
            android:name="de.dachapp.schwimmleitung.ui.LeitungDateiProvider"
            android:authorities="${applicationId}.schwimmleitung.dateien"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/schwimmleitung_dateien" />
        </provider>
    </application>
</manifest>
