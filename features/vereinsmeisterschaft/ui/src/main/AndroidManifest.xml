<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Keine Berechtigungen. -->

    <application>
        <!-- Gibt erzeugte PDFs an die gewählte App frei. Eigene Unterklasse,
             weil andere Module schon FileProvider-Einträge haben (Manifest-Merger). -->
        <provider
            android:name="de.dachapp.vereinsmeisterschaft.ui.VmDateiProvider"
            android:authorities="${applicationId}.vereinsmeisterschaft.dateien"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/vereinsmeisterschaft_dateien" />
        </provider>
    </application>
</manifest>
